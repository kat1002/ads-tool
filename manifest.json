{
  "manifest_version": 3,
  "name": "Playable Batch",
  "version": "1.1.0",
  "description": "Batch tool for ads playables: fetch store name/icon, rename and export.",
  "action": { "default_title": "Playable Batch", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "nativeMessaging"],
  "host_permissions": [
    "https://play.google.com/*",
    "https://itunes.apple.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.mzstatic.com/*",
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ]
}
